{
  "version": 3,
  "protocol_id": "clevr_subject_color_material_3x3x2_multiview_v3",
  "base_manifest": "clevr_material_manifest.json",
  "views_per_cell": 20,
  "view_splits": {
    "train": {"start": 0, "stop": 16},
    "audit": {"start": 16, "stop": 20}
  },
  "render_seed": {
    "base": 420000,
    "shape_color_stride": 100,
    "formula": "base + shape_color_index * shape_color_stride + view_index",
    "paired_axes": ["shape", "color", "view_index"],
    "paired_materials": ["metal", "rubber"]
  },
  "renderer_profile": {
    "id": "multiview_render_v3_material",
    "config": "../configs/multiview_render_v3_material.json",
    "background": {
      "profile_id": "clevr_neutral_fixed_v2",
      "varied": false,
      "world_rgba": [0.05, 0.05, 0.05, 1.0],
      "ground_rgba": [0.5, 0.5, 0.5, 1.0]
    }
  },
  "folds": [
    {"id": "A", "held_out": [["cube", "red", "metal"], ["sphere", "cyan", "metal"], ["cylinder", "gray", "metal"], ["cube", "cyan", "rubber"], ["sphere", "gray", "rubber"], ["cylinder", "red", "rubber"]]},
    {"id": "B", "held_out": [["cube", "cyan", "metal"], ["sphere", "gray", "metal"], ["cylinder", "red", "metal"], ["cube", "gray", "rubber"], ["sphere", "red", "rubber"], ["cylinder", "cyan", "rubber"]]},
    {"id": "C", "held_out": [["cube", "gray", "metal"], ["sphere", "red", "metal"], ["cylinder", "cyan", "metal"], ["cube", "red", "rubber"], ["sphere", "cyan", "rubber"], ["cylinder", "gray", "rubber"]]}
  ],
  "realization_contract": {
    "resolution": [512, 512],
    "image_mode": "RGB",
    "mask_mode": "L",
    "mask_values": [0, 255],
    "renderer_owned_fields": ["camera", "light", "background", "scene_json", "image", "mask", "background_mask"],
    "empirical_rgb": {"space": "srgb_u8", "statistic": "masked_mean", "source": "realized_view_gt_mask"},
    "v2_metal_reference_equivalence": {
      "id": "decoded_pixel_equivalence_v1",
      "rgb": {
        "comparison": "decoded_rgb_u8",
        "max_abs_difference": 1,
        "mean_abs_difference": 0.001
      },
      "mask": {"comparison": "decoded_pixel_exact"},
      "background_mask": {"comparison": "decoded_pixel_exact"},
      "raw_sha256": "record_only"
    }
  }
}
