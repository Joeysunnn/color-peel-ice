{
  "$schema": "clevr_multiview_protocol_v2.schema.json",
  "version": 2,
  "protocol_id": "clevr_subject_color_3x3_multiview_v2",
  "base_manifest": "clevr_3x3_manifest.json",
  "views_per_cell": 20,
  "view_splits": {
    "train": {"start": 0, "stop": 16},
    "audit": {"start": 16, "stop": 20}
  },
  "render_seed": {
    "base": 420000,
    "cell_stride": 100,
    "formula": "base + cell_index * cell_stride + view_index"
  },
  "renderer_profile": {
    "id": "multiview_render_v2",
    "config": "../configs/multiview_render_v2.json",
    "background": {
      "profile_id": "clevr_neutral_fixed_v2",
      "varied": false,
      "world_rgba": [0.05, 0.05, 0.05, 1.0],
      "ground_rgba": [0.5, 0.5, 0.5, 1.0]
    }
  },
  "folds": [
    {"id": "A", "held_out": [["cube", "red"], ["sphere", "cyan"], ["cylinder", "gray"]]},
    {"id": "B", "held_out": [["cube", "cyan"], ["sphere", "gray"], ["cylinder", "red"]]},
    {"id": "C", "held_out": [["cube", "gray"], ["sphere", "red"], ["cylinder", "cyan"]]}
  ],
  "realization_contract": {
    "resolution": [512, 512],
    "image_mode": "RGB",
    "mask_mode": "L",
    "mask_values": [0, 255],
    "renderer_owned_fields": [
      "camera", "light", "background", "scene_json", "image", "mask", "background_mask"
    ],
    "empirical_rgb": {
      "space": "srgb_u8",
      "statistic": "masked_mean",
      "source": "realized_view_gt_mask"
    }
  }
}
